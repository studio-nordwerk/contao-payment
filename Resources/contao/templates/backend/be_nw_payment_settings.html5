<?php $escape = static fn ($value): string => htmlspecialchars((string) $value, ENT_QUOTES, 'UTF-8'); ?>
<h2 class="sub_headline">Zahlung einrichten</h2>
<?php if ($this->error): ?><div class="tl_message"><p class="tl_error" role="alert"><?= $escape($this->error) ?></p></div><?php endif; ?>
<?php if ($this->notice): ?><div class="tl_message"><p class="tl_confirm"><?= $escape($this->notice) ?></p></div><?php endif; ?>
<form data-turbo="false" class="tl_form tl_edit_form" method="post" action="contao?do=nw_payment_settings">
    <input type="hidden" name="REQUEST_TOKEN" value="<?= $escape($this->requestToken) ?>">
    <div class="tl_formbody_edit"><fieldset class="tl_tbox"><legend>Anbieter</legend>
        <div class="widget"><input class="tl_checkbox" type="checkbox" id="bankEnabled" name="bankEnabled" value="1"<?= $this->values['bankEnabled'] ? ' checked' : '' ?>><label for="bankEnabled">Vorkasse aktiv</label></div>
        <div class="widget"><input class="tl_checkbox" type="checkbox" id="stripeEnabled" name="stripeEnabled" value="1"<?= $this->values['stripeEnabled'] ? ' checked' : '' ?>><label for="stripeEnabled">Stripe aktiv</label></div>
        <div class="widget"><input class="tl_checkbox" type="checkbox" id="testMode" name="testMode" value="1"<?= $this->values['testMode'] ? ' checked' : '' ?>><label for="testMode">Stripe-Testmodus</label></div>
    </fieldset><fieldset class="tl_tbox"><legend>Stripe-Zugang</legend>
        <div class="widget"><h3><label for="secretKey">Secret Key</label></h3><input class="tl_text" type="password" id="secretKey" name="secretKey" autocomplete="new-password" value=""><p class="tl_help">Leer lassen, um den gespeicherten Schlüssel zu behalten.</p></div>
        <div class="widget"><h3><label for="webhookSecret">Webhook-Secret</label></h3><input class="tl_text" type="password" id="webhookSecret" name="webhookSecret" autocomplete="new-password" value=""><p class="tl_help">Leer lassen, um das gespeicherte Secret zu behalten.</p></div>
    </fieldset></div><div class="tl_formbody_submit"><div class="tl_submit_container"><button class="tl_submit" name="action" value="save" type="submit">Speichern</button><button class="tl_submit" name="action" value="webhook" type="submit">Webhook bei Stripe anlegen</button></div></div>
</form>
