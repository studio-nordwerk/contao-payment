{
  "name": "nordwerk/contao-payment-bundle",
  "description": "Provider-neutral hosted payments for Contao",
  "license": "MIT",
  "type": "contao-bundle",
  "keywords": [
    "contao",
    "payment",
    "stripe"
  ],
  "require": {
    "php": "^8.3",
    "ext-gd": "*",
    "ext-mbstring": "*",
    "chillerlan/php-qrcode": "^5.0",
    "contao/core-bundle": "^5.7.12",
    "stripe/stripe-php": "^20.0"
  },
  "autoload": {
    "psr-4": {
      "Nordwerk\\PaymentBundle\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Nordwerk\\PaymentBundle\\Tests\\": "tests/"
    }
  },
  "extra": {
    "contao-manager-plugin": "Nordwerk\\PaymentBundle\\ContaoManager\\Plugin"
  }
}
